doctype html
html lang="en"
  head
    = render "layouts/head"
  body.min-h-screen.bg-page.text-ink-body
    header.border-b.border-hairline
      .mx-auto.flex.h-14.max-w-6xl.items-center.justify-between.px-6 class="sm:px-10"
        = link_to "Money Bin", root_path, class: "font-display text-sm font-semibold text-ink-display no-underline"
        = render "ui/theme_toggle"
    main#main-content.mx-auto.max-w-6xl.px-6.py-8 class="sm:px-10"
      = render "ui/flash"
      = yield

- content_for :title, "#{receipt_label(@receipt)} · Receipts · Money Bin"
- content_for :wide_page, true
/ A save redirects back here: morph and keep the scroll, so the form does not jump to the top.
- content_for :head do
  meta name="turbo-refresh-method" content="morph"
  meta name="turbo-refresh-scroll" content="preserve"
/ Live: Receipts::LiveUpdate asks this page to refresh (morph, scroll kept) when OCR is queued, starts,
/ finishes or fails, so the status badge and the data column follow it without a reload.
/ live-refresh asks again for a refresh that Turbo dropped during a visit (live_refresh_controller.js).
div data-controller="live-refresh" data-live-refresh-pending-value=receipt_ocr_in_flight?(@receipt).to_s
  = turbo_stream_from @receipt

= render "ui/page_header", title: receipt_label(@receipt) do
  / No link prefetch: opening a receipt page queues OCR for an unread receipt.
  nav.flex.flex-wrap.items-center.gap-2 aria-label="Receipts" data-turbo-prefetch="false"
    = ui_link_button receipts_path(@filter.to_params), variant: :ghost, size: :sm do
      = ui_icon "list"
      span Back to the list
    - if @previous_id
      = ui_link_button receipt_path(@previous_id, @filter.to_params), variant: :secondary, size: :sm, rel: "prev" do
        = ui_icon "chevron-left"
        span Previous
    - if @next_id
      = ui_link_button receipt_path(@next_id, @filter.to_params), variant: :secondary, size: :sm, rel: "next" do
        span Next
        = ui_icon "chevron-right"
    - if @next_to_label_id
      / After "Save as ground truth" the focus waits here, so Enter opens the next receipt to label.
      = ui_link_button receipt_path(@next_to_label_id, @filter.to_params), variant: :primary, size: :sm, autofocus: true,
        id: "next-to-label", data: { controller: "autofocus" } do
        span Next receipt to label
        = ui_icon "chevron-right"

.mt-3.flex.flex-wrap.items-center.gap-2.text-sm.text-ink-muted
  = render "receipts/status_badge", receipt: @receipt
  span = receipt_kind_label(@receipt)
  - if @receipt.batch
    span = "· batch #{@receipt.batch}"
  - if @receipt.ground_truths.any?
    = link_to "#ground-truth", class: "inline-flex items-center gap-1", "aria-label": "Ground truth" do
      = ground_truth_badges(@receipt.ground_truths)

- if @progress
  p.mt-3.text-sm.text-ink-muted role="status"
    = "Labelled by hand in this list: #{@progress.labelled} of #{pluralize(@progress.receipts, 'receipt')}, #{pluralize(@progress.labelled_items, 'item')}."
    - unless @next_to_label_id
      =< "No other receipt in this list waits to be labelled."

/ Two columns: the photos, which stay in view while the data column scrolls, and the data: the review form
/ while a person may edit the receipt (Receipt#reviewable?), or after a refused save (with the typed values);
/ the stored data, read-only, otherwise.
.review-layout.mt-8
  .review-photos
    = render "receipts/photos", receipt: @receipt
  .min-w-0.space-y-8
    - if @review || @receipt.reviewable?
      = render "receipts/review", receipt: @receipt, review: @review, filter: @filter, chosen_account: @chosen_account
    - else
      = render "receipts/data", receipt: @receipt
    = render "receipts/ground_truth", receipt: @receipt, filter: @filter

# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files, at any depth, except the sample.
.env*
!/.env.example

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore key files for decrypting credentials and more, per-environment credential keys included.
/config/*.key
/config/credentials/*.key

/app/assets/builds/*
!/app/assets/builds/.keep

# Test coverage reports (SimpleCov for Ruby, coverage.py for Python).
/coverage/
.coverage
htmlcov/

# Personal data never enters the repository: any folder named "data", at any depth.
data/

# A second line of defence for receipt photos and for the output of tools/receipt_ingest/, which both
# live outside the repository: iPhone photos and the numbered receipt images.
*.heic
*.HEIC
*.heif
*.HEIF
rcpt_*.jpg

# Python caches and virtual environments.
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/

# Model weight files.
*.safetensors
*.gguf
*.bin
*.pt
*.pth
*.h5
*.ckpt
*.onnx
*.mlx
*.npz

# Claude Code: project config under .claude/ is committed; these parts are per-machine.
/.claude/worktrees/
/.claude/settings.local.json
/.claude/agent-memory-local/

# Copied to .env by bin/setup. Loaded by dotenv in development and production; test runs read no .env
# file (config/application.rb), so nothing here can point the tests at development data.
# Never commit .env: it is for this machine only.
# Every setting is optional; the values shown are the defaults the app uses without them.

# Redis for Sidekiq, the cache and Action Cable. Default: db 5 in development, 4 in production.
# Tests ignore this line; to move the tests too, set REDIS_URL in the real environment (CI does).
# REDIS_URL=redis://localhost:6379/5

# Base URL of the Python ML service in ml/ (receipt OCR), started by bin/dev.
# ML_SERVICE_URL=http://127.0.0.1:8100

# Timeouts of the ML client (app/services/ml_client.rb), in seconds: opening the connection, waiting for an
# OCR answer (a real model can be slow), waiting for a categorisation answer.
# ML_SERVICE_OPEN_TIMEOUT=2
# ML_SERVICE_OCR_TIMEOUT=120
# With OCR_BACKEND=mlx a long receipt can take over a minute, twice that when its first answer needs a
# repair pass, and the service reads one receipt at a time. A timed-out request keeps the model busy until
# it finishes, so a retry waits behind it: raise this (for example to 600) when you use the mlx backend.
# Category suggestions for one receipt's items: a local model takes under a second per item, but it may first
# finish another receipt's OCR.
# ML_SERVICE_CATEGORISE_TIMEOUT=120

# Which OCR engine the ML service uses: stub (default), mlx (a local vision model, Apple silicon only) or
# openrouter (a hosted vision model; receipt photos leave the machine, to zero-retention endpoints only).
# See ml/README.md.
# OCR_BACKEND=stub

# The transaction categoriser's artefact (python -m categoriser.serving, outside the repository). Empty: the newest
# transaction-categoriser-*.serving.joblib in ~/Documents/money_bin_data/models/. Always local; see ml/README.md.
# TRANSACTION_CATEGORISER_MODEL=

# Which engine suggests categories for receipt items, chosen apart from OCR: stub (default), mlx (a local
# model; with OCR_BACKEND=mlx and the same model, one model in memory does both), openrouter (a hosted
# model; only item names leave the machine, to zero-retention endpoints only), decisions (a hosted decision
# model through OpenRouter's Decisions API, same rules; see DECISIONS_MODEL) or off (no suggestion at all,
# the label memory's included: for labelling receipts no categoriser pre-filled; the app reads it too).
# See ml/README.md and docs/domain.md, "Labelling without suggestions".
# CATEGORISE_BACKEND=stub
# The mlx categoriser's model; empty means MLX_OCR_MODEL (the one loaded model does both jobs).
# MLX_CATEGORISE_MODEL=
# A calibration of the categoriser's scores, fitted by `python -m evaluation.item_categories_calibrate` and
# kept outside the repository. Without it the scores are the model's raw probabilities (calibrated: false).
# CATEGORISE_CALIBRATION_FILE=

# The mlx backend: the model (a Hugging Face id, downloaded once into the Hugging Face cache, or a folder),
# the most tokens of one answer, the longer side photos are scaled to, and JSON-constrained decoding.
# MLX_OCR_MODEL=mlx-community/Qwen3-VL-8B-Instruct-4bit
# MLX_OCR_MAX_TOKENS=3072
# MLX_OCR_IMAGE_MAX_SIDE=2048
# MLX_OCR_CONSTRAINED_DECODING=true

# The openrouter backend: the API key (a secret: only here, never in git), the model id from
# openrouter.ai/models (no default: the service does not start without it), the seconds for one receipt
# (both calls when it needs the repair pass; keep it under ML_SERVICE_OCR_TIMEOUT), the most tokens of one
# answer, the longer side photos are scaled to, and JSON-schema answers when the model's zero-retention
# endpoints support them. Set the OpenRouter account's privacy settings to "ZDR only" as well.
# OPENROUTER_API_KEY=
# OPENROUTER_OCR_MODEL=
# The model that suggests item categories with CATEGORISE_BACKEND=openrouter (no default; text only is fine).
# OPENROUTER_CATEGORISE_MODEL=
# The decision model that suggests item categories with CATEGORISE_BACKEND=decisions (no default; a concrete
# id, not a ~...-latest alias), how it asks (flat: one question per item over every category; two-stage:
# the group, then the category), whether each item sees the other item names of its receipt, and the most
# items per request. Only item names and the category list are sent; never transactions.
# DECISIONS_MODEL=typesafe/jev-1.14
# DECISIONS_STRATEGY=flat
# DECISIONS_RECEIPT_CONTEXT=true
# DECISIONS_MAX_QUESTIONS=16
# OPENROUTER_TIMEOUT=100
# OPENROUTER_MAX_TOKENS=3072
# OPENROUTER_OCR_IMAGE_MAX_SIDE=2048
# OPENROUTER_STRUCTURED_OUTPUT=true

# Largest image the ML service accepts, in bytes (15 MB); the app itself refuses photos over 15 MB anyway.
# ML_MAX_IMAGE_BYTES=15728640

# Port of the Rails server started by bin/dev.
# PORT=3100

# Production only: one more host name the app answers to, besides localhost, 127.0.0.1 and ::1
# (config/environments/production.rb). Requests for any other name get a 403.
# APP_HOST=
